{
  "name": "atw-public-api-server",
  "version": "0.1.0",
  "private": true,
  "description": "ATW course project: a small web server that aggregates five public APIs.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "serve": "node dist/server.js"
  },
  "dependencies": {
    "dotenv": "^16.6.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  }
}
